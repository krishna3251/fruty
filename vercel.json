{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/collections/fermented-pickles/?",
      "headers": {
        "Location": "/shop"
      },
      "status": 301
    },
    {
      "src": "/products/fermented-cucumber-pickle/?",
      "headers": {
        "Location": "/products/tropical-cucumber-pickle"
      },
      "status": 301
    },
    {
      "src": "/products/fermented-pale-vegetable-pickle/?",
      "dest": "/404.html",
      "status": 410
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/shop/?",
      "dest": "/shop/index.html"
    },
    {
      "src": "/products/(mango|strawberry|blueberry|orange|lemon|avocado)/?",
      "dest": "/products/$1/index.html"
    },
    {
      "src": "/(privacy|terms|contact|thank-you)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/pickles/?",
      "dest": "/pickles/index.html"
    },
    {
      "src": "/collections/(tropical-feast)/?",
      "dest": "/collections/$1/index.html"
    },
    {
      "src": "/products/(tropical-pineapple-pickle|tropical-cucumber-pickle)/?",
      "dest": "/products/$1/index.html"
    },
    {
      "src": "/(ordering|fruit-demo|fruit-story)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
