{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://*.clerk.accounts.dev https://*.clerk.services https://challenges.cloudflare.com https://*.protect.clerk.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.clerk.com https://*.google-analytics.com https://*.googletagmanager.com; media-src 'self'; font-src 'self'; connect-src 'self' https://*.clerk.accounts.dev https://*.clerk.services https://*.protect.clerk.com:* https://img.clerk.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com https://*.protect.clerk.com https://*.clerk.accounts.dev; form-action 'self'; upgrade-insecure-requests",
        "Strict-Transport-Security": "max-age=31536000",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "X-Permitted-Cross-Domain-Policies": "none"
      },
      "continue": true
    },
    {
      "src": "/collections/fermented-pickles/?",
      "headers": {
        "Location": "/shop"
      },
      "status": 301
    },
    {
      "src": "/products/fermented-cucumber-pickle/?",
      "headers": {
        "Location": "/products/tropical-cucumber-pickle"
      },
      "status": 301
    },
    {
      "src": "/products/fermented-pale-vegetable-pickle/?",
      "dest": "/404.html",
      "status": 410
    },
    {
      "src": "/pickles/?",
      "headers": {
        "Location": "/shop"
      },
      "status": 301
    },
    {
      "src": "/(.+)/",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "/(account|sign-in|sign-up)/?",
      "dest": "/$1/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "private, no-store"
      }
    },
    {
      "src": "/admin/?",
      "dest": "/admin/index.html",
      "headers": {
        "Cache-Control": "private, no-store",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/products/((?!mango$|strawberry$|blueberry$|orange$|lemon$|avocado$)[a-z0-9]+(?:-[a-z0-9]+)*)",
      "dest": "/api/product-page?slug=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/shop/?",
      "dest": "/shop/index.html"
    },
    {
      "src": "/products/(mango|strawberry|blueberry|orange|lemon|avocado)/?",
      "dest": "/products/$1/index.html"
    },
    {
      "src": "/(privacy|terms|contact|thank-you|shipping|returns)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/collections/(tropical-feast)/?",
      "dest": "/collections/$1/index.html"
    },
    {
      "src": "/products/(tropical-pineapple-pickle|tropical-cucumber-pickle)/?",
      "dest": "/products/$1/index.html"
    },
    {
      "src": "/products/[a-z0-9]+(?:-[a-z0-9]+)*/?",
      "dest": "/shop/index.html"
    },
    {
      "src": "/(ordering|fruit-demo|fruit-story)/?",
      "dest": "/$1/index.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "functions": {
    "api/product-page.ts": {
      "includeFiles": "dist/{index,404}.html"
    }
  }
}
