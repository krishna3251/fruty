{
  "name": "furity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node --import tsx scripts/build-pages.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src server api scripts tests *.ts *.json *.md index.html public/404.html",
    "format:check": "prettier --check src server api scripts tests *.ts *.json *.md index.html public/404.html",
    "verify": "npm run build && npm test && npm run format:check",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "catalogue:upgrade": "node --import tsx scripts/upgrade-catalogue.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.2",
    "@clerk/react": "^6.18.1",
    "@neondatabase/serverless": "^1.2.0",
    "@netlify/blobs": "^11.1.6",
    "@vercel/blob": "^2.8.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.14.2",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "overrides": {
    "zod": "^4.6.7",
    "@grpc/grpc-js": "^1.14.6",
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
