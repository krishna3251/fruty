# Public build-time values; never put API secrets in VITE_ variables.
VITE_PUBLIC_SITE_URL=https://fruty-fawn.vercel.app
VITE_BUSINESS_NAME=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_ADDRESS=
# Optional GA4 ID. No analytics loads without a valid ID AND explicit consent.
VITE_GA_MEASUREMENT_ID=
# Optional HTTPS newsletter API: POST {email}; 2xx JSON {subscribed:true} confirms success.
# The endpoint must validate server-side, implement rate limits, and support CORS.
VITE_NEWSLETTER_ENDPOINT=
# Tropical Feast only: verified public HTTPS direct-message URL. Blank disables DM.
# Do not use the website owner's contact unless confirmed as this collection's seller.
VITE_TROPICAL_FEAST_DM_URL=

# Clerk public frontend key only. Never prefix CLERK_SECRET_KEY with VITE_.
# The build also accepts NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY provisioned by Vercel.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-only owner panel configuration. Never use VITE_ for these values.
# Match a verified email address on your Clerk account.
ADMIN_EMAIL=
# Salt:hash generated with Node crypto scrypt (64 bytes); never commit plaintext.
ADMIN_PASSWORD_HASH=
# Connected private Vercel Blob store; injected by Vercel Storage.
BLOB_READ_WRITE_TOKEN=
# Marketplace injects CLERK_SECRET_KEY on the server (not required by the browser).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Neon PostgreSQL — SERVER ONLY; Vercel Marketplace may supply POSTGRES_URL as alias.
# Never create VITE_DATABASE_URL or expose these in browser builds.
DATABASE_URL=
# Existing Neon Auth envs are not used; Clerk remains the sole auth provider.
